{
  "id": "orca",
  "name": "Orca",
  "version": "0.2.0",
  "apiVersion": 1,
  "entry": "index.mjs",
  "instructions": "SKILL.md",
  "configuration": [
    {
      "key": "cli_path",
      "label": "Orca CLI",
      "type": "path",
      "defaultValue": "orca"
    }
  ],
  "tools": [
    {
      "name": "cli_query",
      "description": "读取 Orca 当前版本 CLI 指导、命令帮助、已打开项目、工作区与终端状态。项目名与 ID 通过 repo list 发现，无需用户提供绝对路径。",
      "effect": "read",
      "confirmation": "never",
      "timeoutSeconds": 130,
      "inputSchema": {
        "type": "object",
        "required": [
          "arguments"
        ],
        "additionalProperties": false,
        "properties": {
          "arguments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Orca CLI argv，不包含可执行文件。先读 skills get orca-cli；例如 [\"repo\", \"list\"]。"
          },
          "timeoutSeconds": {
            "type": "integer",
            "description": "单次 CLI 超时，1–120 秒，默认 20。"
          }
        }
      }
    },
    {
      "name": "cli_execute",
      "description": "按用户要求执行 Orca CLI 命令，以 argv 传参。先用 cli_query 读取实时文档、发现项目；支持 Orca 当前版本能力，不限定固定交接流程。命令返回不等于任务完成；用 cli_query 回读目标。",
      "effect": "write",
      "confirmation": "explicitDirectOtherwiseConfirm",
      "timeoutSeconds": 140,
      "inputSchema": {
        "type": "object",
        "required": [
          "arguments"
        ],
        "additionalProperties": false,
        "properties": {
          "arguments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Orca CLI argv，不包含可执行文件。先读 skills get orca-cli；例如 [\"repo\", \"list\"]。"
          },
          "timeoutSeconds": {
            "type": "integer",
            "description": "单次 CLI 超时，1–120 秒，默认 20。"
          }
        }
      }
    },
    {
      "name": "query_handoff",
      "description": "按交接 ID 查询 Orca 工作区、Agent 终端状态与有限输出。终端空闲不证明开发任务完成。",
      "effect": "read",
      "confirmation": "never",
      "timeoutSeconds": 20,
      "inputSchema": {
        "type": "object",
        "required": [
          "handoffID"
        ],
        "additionalProperties": false,
        "properties": {
          "handoffID": {
            "type": "string",
            "minLength": 1
          },
          "terminalHandle": {
            "type": "string",
            "description": "仅在终端匹配不唯一时，使用用户明确选择的该工作区 terminal handle。"
          }
        }
      }
    },
    {
      "name": "send_message",
      "description": "向已交接的 Orca Agent 发送用户明确要求的后续 prompt。返回接收回执，不等待执行完成。",
      "effect": "write",
      "confirmation": "explicitDirectOtherwiseConfirm",
      "timeoutSeconds": 120,
      "inputSchema": {
        "type": "object",
        "required": [
          "handoffID",
          "prompt"
        ],
        "additionalProperties": false,
        "properties": {
          "handoffID": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "terminalHandle": {
            "type": "string",
            "description": "仅在终端匹配不唯一时，使用用户明确选择的该工作区 terminal handle。"
          }
        }
      }
    }
  ]
}
